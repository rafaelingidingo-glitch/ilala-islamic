generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// NEWS — announcements & stories shown on Home and the News & Events page.
// Managed from the admin panel (Phase 2).
// ---------------------------------------------------------------------------
model News {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String
  category  String   @default("Announcement")
  image     String?
  featured  Boolean  @default(false)
  published Boolean  @default(true)
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// EVENTS — calendar items shown on Home and the News & Events page.
// ---------------------------------------------------------------------------
model Event {
  id         String   @id @default(cuid())
  title      String
  description String
  location   String
  time       String   @default("")
  category   String   @default("General")
  startDate  DateTime
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// STAFF — staff directory shown on the About page, managed in the admin panel.
// ---------------------------------------------------------------------------
model Staff {
  id         String   @id @default(cuid())
  name       String
  role       String
  department String   @default("Teaching")
  initials   String   @default("")
  order      Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// MESSAGES — submissions from the website contact form, read in the admin
// inbox. `read` tracks whether the office has seen each message.
// ---------------------------------------------------------------------------
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String   @default("General enquiry")
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
