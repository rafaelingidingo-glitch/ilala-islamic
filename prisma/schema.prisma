generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// NEWS — announcements & stories shown on Home and the News & Events page.
// Managed from the admin panel (Phase 2).
// ---------------------------------------------------------------------------
model News {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String
  category  String   @default("Announcement")
  image     String?
  featured  Boolean  @default(false)
  published Boolean  @default(true)
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// EVENTS — calendar items shown on Home and the News & Events page.
// ---------------------------------------------------------------------------
model Event {
  id         String   @id @default(cuid())
  title      String
  description String
  location   String
  time       String   @default("")
  category   String   @default("General")
  startDate  DateTime
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// STAFF — staff directory shown on the About page, managed in the admin panel.
// ---------------------------------------------------------------------------
model Staff {
  id         String   @id @default(cuid())
  name       String
  role       String
  department String   @default("Teaching")
  initials   String   @default("")
  order      Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// MESSAGES — submissions from the website contact form, read in the admin
// inbox. `read` tracks whether the office has seen each message.
// ---------------------------------------------------------------------------
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String   @default("General enquiry")
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// APPLICATIONS — online admission applications submitted from the public
// Admissions page. Each application gets a unique reference number
// (e.g. `BS-2026-0001`) that parents use to track its status.
// Status workflow: PENDING → UNDER_REVIEW → INTERVIEW → ACCEPTED /
// WAITLISTED / REJECTED. SQLite has no enums, so status is a plain string.
// ---------------------------------------------------------------------------
model Application {
  id                String    @id @default(cuid())
  applicationNumber String    @unique
  academicYear      Int

  // --- Applicant (student) -------------------------------------------------
  firstName         String
  middleName        String    @default("")
  lastName          String
  dateOfBirth       DateTime
  gender            String // "Male" | "Female"
  entryClass        String // "Form 1" … "Form 6"
  boarding          String    @default("Day") // "Day" | "Boarding"
  previousSchool    String

  // --- Academic background -------------------------------------------------
  examType          String    @default("") // PSLE / CSEE / FTNA
  examIndex         String    @default("") // examination index number
  examResults       String    @default("") // division / marks summary
  personalStatement String    @default("")

  // --- Parent / guardian ---------------------------------------------------
  parentName        String
  parentRelationship String // Mother / Father / Guardian / Other
  parentEmail       String
  parentPhone       String
  parentAddress     String    @default("")

  // --- Extra information from the applicant --------------------------------
  notes             String    @default("") // how they heard about us, questions…

  // --- Admissions office workflow ------------------------------------------
  status            String    @default("PENDING")
  adminNotes        String    @default("") // private notes, never shown publicly
  reviewedAt        DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}
